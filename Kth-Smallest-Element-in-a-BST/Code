/**
 * Definition for a binary tree node.
 * public class TreeNode {
 *     int val;
 *     TreeNode left;
 *     TreeNode right;
 *     TreeNode() {}
 *     TreeNode(int val) { this.val = val; }
 *     TreeNode(int val, TreeNode left, TreeNode right) {
 *         this.val = val;
 *         this.left = left;
 *         this.right = right;
 *     }
 * }
 */
class Solution {
    int count=0;
    public int kthSmallest(TreeNode root, int k) {
        return preorder(root, k);
    }
    public int preorder(TreeNode root, int k){
        if(root==null){
            return -1;
        }
        int ele=preorder(root.left, k);
        if(ele!=-1){
            return ele;
        }
        if(++count==k){ 
            return root.val; //when the count reaches the kth node(in inorder order), every recursion will return that node's 
                            //value, before that every node will return only -1(both left and right).
        }
        return preorder(root.right, k);
        
    }
}
