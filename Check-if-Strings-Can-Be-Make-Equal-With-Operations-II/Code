class Solution {
    public boolean checkStrings(String s1, String s2) {
        HashMap<Character, Integer> odd=new HashMap<>();
        HashMap<Character, Integer> even=new HashMap<>();

        for(int i=0;i<s1.length();i++){
            if(i%2==0){
                if(even.containsKey(s1.charAt(i))){
                    even.put(s1.charAt(i), even.get(s1.charAt(i))+1);
                }
                else{
                    even.put(s1.charAt(i), 1);
                }
                if(even.containsKey(s2.charAt(i))){
                    even.put(s2.charAt(i), even.get(s2.charAt(i))-1);
                }
                else{
                    even.put(s2.charAt(i), -1);
                }
            }

            else{
                if(odd.containsKey(s1.charAt(i))){
                    odd.put(s1.charAt(i), odd.get(s1.charAt(i))+1);
                }
                else{
                    odd.put(s1.charAt(i), 1);
                }
                if(odd.containsKey(s2.charAt(i))){
                    odd.put(s2.charAt(i), odd.get(s2.charAt(i))-1);
                }
                else{
                    odd.put(s2.charAt(i), -1);
                }
            }
        }

        for(char i:odd.keySet()){
            if(odd.get(i)!=0){
                return false;
            }
        }
        for(char i:even.keySet()){
            if(even.get(i)!=0){
                return false;
            }
        }
        return true;
    }
}
